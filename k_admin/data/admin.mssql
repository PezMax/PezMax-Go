CREATE TABLE[goadmin_roles] (
 [id] int   identity(1,1) ,
 [name] varchar(50)   NOT NULL UNIQUE,
 [slug] varchar(50)   NOT NULL,
 [created_at] datetime NULL DEFAULT GETDATE(),
 [updated_at] datetime NULL DEFAULT GETDATE(),
  PRIMARY KEY ([id]),
) 

