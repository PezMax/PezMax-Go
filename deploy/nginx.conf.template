# KAdmin 边缘反代：Nginx 压缩与下载分配，tc 限制共享出口预算。
# Dockerfile.edge 的 35-egress-limit.sh 在 Nginx 启动前设置 eth0 TBF + fq_codel：
#   KADMIN_EDGE_EGRESS_RATE        — 整个 edge 出口的 bit/s 预算，默认 8mbit。
#   KADMIN_EDGE_EGRESS_BURST_BYTES — 单桶允许的有限突发，默认 32768 bytes。
# 所有 worker、Token、连接与响应路径共用该内核队列，配置失败时拒绝启动。
# 模板变量由 nginx 官方镜像启动时的 envsubst 注入（/etc/nginx/templates/*.template，
# 只替换容器内已定义的环境变量，nginx 运行时变量不受影响）：
#   KADMIN_UPSTREAM          — 后端地址。docker compose 内默认 kadmin:9033；
#                              后端在宿主机直跑时改为 host.docker.internal:9033。
#   KADMIN_EDGE_DL_RATE_FAST — 独占档：0–1 个在写连接时单个下载的速率。
#                              用于单请求分配，总出口始终受 tc 共享预算限制。
#   KADMIN_EDGE_DL_RATE_MID  — 中档：2–3 个并发下载。
#   KADMIN_EDGE_DL_RATE_LOW  — 低档：4 个及以上并发下载。
#   KADMIN_EDGE_DL_MAXCONN   — 全体客户端共享的下载总并发帽。
#
# 弹性限速：每请求限速值按“当前正在写出响应的连接数”
# 分档映射（$connections_writing 为 stub_status 模块内置变量，即时可用，
# 无需有人抓取 /stub_status 端点）。在线用户少时单个下载自动提到独占档，
# 并发上来后整体回落到预算档：
#   独占(0–1)×FAST → 2–3×MID → 4+×LOW（总并发被 MAXCONN 兜住）。
# 分档与 limit_conn 只控制单请求速率和并发数；总带宽由独立的 tc 单桶封顶，
# 不依赖连接数采样是否及时。单连接空闲后的有限突发也计入同一个桶。

# 文本类响应出站压缩：JSON 列表、后台控制台 HTML/CSS/JS 通常压掉 70%–90%。
# 图片/PDF/压缩包不在此列（压不动），由后端已按 Content-Type 跳过。
gzip on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_vary on;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml
    application/xhtml+xml
    image/svg+xml;

# 弹性限速映射：正在写出的连接数（含 API 小响应，方向偏保守——多算并发
# 只会降速不会超发）→ 每请求下载速率档位。
map $connections_writing $download_rate {
    default          ${KADMIN_EDGE_DL_RATE_MID};  # 信号缺失兜底，取保守中档
    ""               ${KADMIN_EDGE_DL_RATE_FAST}; # 空闲：独占快速档
    ~^0$             ${KADMIN_EDGE_DL_RATE_FAST};
    ~^1$             ${KADMIN_EDGE_DL_RATE_FAST};
    ~^[2-3]$         ${KADMIN_EDGE_DL_RATE_MID};
    ~^[4-9]$         ${KADMIN_EDGE_DL_RATE_LOW};
    ~^[1-9][0-9]+$   ${KADMIN_EDGE_DL_RATE_LOW};  # 10+：低档；总出口由 tc 共享预算封顶
}

# 并发限制区：per-IP 减少单个来源的并行下载；IPv4/IPv6 的计数可分别存在。
# 总出口预算不依赖这些 key，由 eth0 的同一内核队列覆盖。
limit_conn_zone $binary_remote_addr zone=download_conn:10m;
limit_conn_zone $server_addr zone=download_total:10m;

server {
    listen 80;
    server_name _;

    # 上传透传给后端自行限额（datum 侧 200MB 上限），Nginx 不再设卡。
    client_max_body_size 0;

    # stub_status 计数端点：仅供本机/容器内排障观察（curl /stub_status），
    # 弹性限速本身不依赖有人抓取它。
    location = /stub_status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
    }

    # 大文件下载（桌面端 /datum/download/file）：单客户端单连接 + 弹性限速。
    # proxy_buffering 保持默认开启：后端把字节快速吐到 Nginx 本地缓冲后即可
    # 释放，单请求按 limit_rate 分配，全部出流再通过共享 tc 预算。
    location /datum/download/ {
        limit_conn download_conn 1;
        limit_conn download_total ${KADMIN_EDGE_DL_MAXCONN};
        limit_rate $download_rate;
        proxy_pass http://${KADMIN_UPSTREAM};
        include /etc/nginx/kadmin-proxy-headers.conf;
        proxy_read_timeout 300s;
    }

    # 其余流量（JSON API、控制台、静态资源、Swagger）压缩与透传后也经过
    # eth0 的共享预算，大响应不能通过切换 URL 绕过总出口上限。
    location / {
        proxy_pass http://${KADMIN_UPSTREAM};
        include /etc/nginx/kadmin-proxy-headers.conf;
        proxy_read_timeout 300s;
    }
}
