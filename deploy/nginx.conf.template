# KAdmin 边缘反代（Nginx）：为上行受限的主机做三层减负。
# 模板变量由 nginx 官方镜像启动时的 envsubst 注入（/etc/nginx/templates/*.template）：
#   KADMIN_UPSTREAM — 后端地址。docker compose 内默认 kadmin:9033；
#                     后端在宿主机直跑时改为 host.docker.internal:9033。
#
# 带宽账本（按总上行调整 limit_rate）：limit_rate 是“每连接”限速，
# 每个下载端点已通过 limit_conn 限制为单客户端单连接。
#   例：总上行 10Mbps ≈ 1.25MB/s → 下载限速 1m 留一半给 API 与页面。

# 文本类响应出站压缩：JSON 列表、后台控制台 HTML/CSS/JS 通常压掉 70%–90%。
# 图片/PDF/压缩包不在此列（压不动），由后端已按 Content-Type 跳过。
gzip on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_vary on;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml
    application/xhtml+xml
    image/svg+xml;

# 每客户端下载并发限制（连接数维度）
limit_conn_zone $binary_remote_addr zone=download_conn:10m;

server {
    listen 80;
    server_name _;

    # 上传透传给后端自行限额（datum 侧 200MB 上限），Nginx 不再设卡。
    client_max_body_size 0;

    # 大文件下载（桌面端 /datum/download/file）：限并发 + 限速。
    # proxy_buffering 保持默认开启：后端把字节快速吐到 Nginx 本地缓冲后即可
    # 释放，出网速度由 limit_rate 单独整形，后端连接不会长期挂占用。
    location /datum/download/ {
        limit_conn download_conn 1;
        limit_rate 1m;   # 每连接 1MB/s，按总上行调整
        proxy_pass http://${KADMIN_UPSTREAM};
        include /etc/nginx/kadmin-proxy-headers.conf;
        proxy_read_timeout 300s;
    }

    # 其余流量（JSON API、控制台、静态资源、Swagger）只做压缩与透传。
    location / {
        proxy_pass http://${KADMIN_UPSTREAM};
        include /etc/nginx/kadmin-proxy-headers.conf;
        proxy_read_timeout 300s;
    }
}
