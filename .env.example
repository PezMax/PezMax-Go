# pezmax-go 数据库容器（docker-compose.yml）的可覆盖变量
# 复制为 .env 后修改即可；k_admin 后端对应读取 k_admin/.env（两者需保持一致）

# PostgreSQL
PEZMAX_DB_NAME=pezmax
PEZMAX_DB_USER=postgres
PEZMAX_DB_PASSWORD=
PEZMAX_DB_PORT=25432
# 默认仅本机可访问；远程访问时显式改为可信私网 IP。
PEZMAX_DB_BIND_IP=127.0.0.1
# 默认 pgvector/pgvector:pg16，内置 vector/pg_trgm 扩展；保持 PostgreSQL 16
# 主版本才能复用现有数据卷。仅在镜像代理改写名称时才需要覆盖。
# PEZMAX_DB_IMAGE=pgvector/pgvector:pg16

# Redis
PEZMAX_REDIS_PASSWORD=
PEZMAX_REDIS_PORT=26379
PEZMAX_REDIS_BIND_IP=127.0.0.1

# MinIO
PEZMAX_MINIO_ACCESS_KEY=
PEZMAX_MINIO_SECRET_KEY=
PEZMAX_MINIO_BUCKET=ptmj
PEZMAX_MINIO_API_PORT=29000
PEZMAX_MINIO_CONSOLE_PORT=29001
PEZMAX_MINIO_BIND_IP=127.0.0.1
# 公网可访问的 MinIO 地址（kadmin 容器上传时按此组装入库 URL）
PEZMAX_MINIO_PUBLIC_BASE=http://127.0.0.1:29000
PEZMAX_APP_PORT=9033
PEZMAX_APP_BIND_IP=127.0.0.1
# Web 管理端与 Go 后端使用同一绑定地址，默认端口 18088。
PEZMAX_ADMIN_WEB_PORT=18088
# 仅镜像构建期间使用；容器内需能访问 host.docker.internal。
# PEZMAX_BUILD_PROXY=http://host.docker.internal:7890
# Debian 镜像构建可用的签名软件源基础地址；可留空使用官方源。
# PEZMAX_DEBIAN_MIRROR=http://mirrors.aliyun.com

# Nginx 边缘反代（docker compose --profile edge up -d edge 启用）
# 对外暴露端口；后端宿主机直跑时把 KADMIN_EDGE_UPSTREAM 改为 host.docker.internal:9033
PEZMAX_EDGE_PORT=8080
KADMIN_EDGE_UPSTREAM=kadmin:9033
# 可选构建镜像源，默认使用 Alpine 官方源；包签名校验始终启用。
# KADMIN_EDGE_APK_MIRROR=https://mirrors.aliyun.com/alpine
# 整个 edge 容器出口的共享预算，与 Token、连接数和 Nginx worker 无关。
# tc 单位是 bit/s：8mbit = 1,000,000 bytes/s，为 10Mbps 物理上行留出 20% 余量。
KADMIN_EDGE_EGRESS_RATE=8mbit
# 允许有限突发（bytes）；默认 32KiB，范围 1500–1048576。
KADMIN_EDGE_EGRESS_BURST_BYTES=32768
# 以下是每请求分档速率（Nginx 单位为 bytes/s），用于分配单个连接速率；
# 即使分档速率或连接数增加，也不能提高上面的共享出口预算。
KADMIN_EDGE_DL_RATE_FAST=5m
KADMIN_EDGE_DL_RATE_MID=2560k
KADMIN_EDGE_DL_RATE_LOW=640k
KADMIN_EDGE_DL_MAXCONN=16

# 后端 JWT 密钥（kadmin 容器用；与 k_admin/.env 保持一致）
KADMIN_JWT_SECRET=

# Eino RAG 模型层（kadmin 容器；默认关闭）
# API Key 仅通过此文件或密钥管理系统注入，不提交到仓库。
KADMIN_RAG_ENABLED=false
# KADMIN_RAG_CHAT_BASE_URL=https://api.openai.com/v1
# KADMIN_RAG_CHAT_API_KEY=
# KADMIN_RAG_CHAT_MODEL=
# KADMIN_RAG_CHAT_TIMEOUT=60s
# KADMIN_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# KADMIN_RAG_EMBEDDING_API_KEY=
# KADMIN_RAG_EMBEDDING_MODEL=
# KADMIN_RAG_EMBEDDING_DIM=1024
# KADMIN_RAG_EMBEDDING_TIMEOUT=30s
# Vision 可选；模型名为空即关闭，BaseURL/APIKey 留空时复用 chat。
# KADMIN_RAG_VISION_MODEL=
# KADMIN_RAG_VISION_BASE_URL=
# KADMIN_RAG_VISION_API_KEY=
# KADMIN_RAG_VISION_TIMEOUT=60s

# 出站 QoS：试卷/电子书下载、头像/封面共享一个 bulk 令牌桶（默认 80% 上行），
# 文件树/hash 校验/通知等小响应不受限。生产容器默认开启（未声明上行按 10Mbps）；
# 显式声明总上行即按该值启用，置 0 强制关闭。详见 k_admin/internal/kadmin/qos.go
# KADMIN_QOS_UPLINK_MBPS=10
# KADMIN_QOS_BULK_SHARE=0.8
# KADMIN_QOS_BURST_MB=4
