# pezmax-go 数据库容器（docker-compose.yml）的可覆盖变量
# 复制为 .env 后修改即可；k_admin 后端对应读取 k_admin/.env（两者需保持一致）

# PostgreSQL
PEZMAX_DB_NAME=pezmax
PEZMAX_DB_USER=postgres
PEZMAX_DB_PASSWORD=pezmax_dev_pwd
PEZMAX_DB_PORT=25432

# Redis
PEZMAX_REDIS_PASSWORD=pezmax_redis_pwd
PEZMAX_REDIS_PORT=26379

# MinIO
PEZMAX_MINIO_ACCESS_KEY=pezmax_minio
PEZMAX_MINIO_SECRET_KEY=pezmax_minio_pwd
PEZMAX_MINIO_BUCKET=ptmj
PEZMAX_MINIO_API_PORT=29000
PEZMAX_MINIO_CONSOLE_PORT=29001
